{
  "name": "mcp-dependencies",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/core && npm run build --workspace packages/cli --workspace packages/vscode-extension",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
